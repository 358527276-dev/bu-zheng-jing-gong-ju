/* ===== 全局样式 · 日式动漫风 ===== */
page {
  background: linear-gradient(180deg, #fff0f5 0%, #fce4ec 20%, #f3e5f5 50%, #ede7f6 100%);
  font-size: 28rpx;
  color: #3c2a3e;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  min-height: 100vh;
  position: relative;
}

/* 樱花飘落背景层 */
.sakura-layer {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.sakura {
  position: absolute;
  width: 24rpx; height: 24rpx;
  background: radial-gradient(circle, #ffb7c5 40%, #ff8fa3 70%, transparent 71%);
  border-radius: 50% 0 50% 0;
  animation: fall 8s linear infinite;
  opacity: 0.7;
}

@keyframes fall {
  0% { transform: translateY(-50rpx) rotate(0deg); opacity: 0; }
  10% { opacity: 0.8; }
  90% { opacity: 0.6; }
  100% { transform: translateY(100vh) rotate(360deg); opacity: 0; }
}

.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

/* ===== 卡片 · 金边描边 ===== */
.card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 90, 0.08),
              0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid transparent;
  background-clip: padding-box;
  position: relative;
  overflow: hidden;
}

/* 金边卡片高亮 */
.card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, #d4a574, #f4d03f, #d4a574, transparent);
}

/* ===== 按钮 · 星星元素 ===== */
.btn-primary {
  background: linear-gradient(135deg, #8e44ad 0%, #c084fc 50%, #ff6b9d 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 12rpx 0;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(142, 68, 173, 0.4),
              inset 0 2rpx 8rpx rgba(255, 255, 255, 0.25);
  letter-spacing: 3rpx;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  position: relative;
}

.btn-primary::after {
  border: 2rpx solid rgba(244, 208, 63, 0.6);
  border-radius: 999rpx;
}

.btn-primary[disabled] {
  background: linear-gradient(135deg, #d1d5db, #9ca3af);
  color: #fff;
  box-shadow: none;
  opacity: 0.6;
}

.btn-plain {
  background: rgba(255, 255, 255, 0.9);
  color: #8e44ad;
  border: 2rpx solid #8e44ad;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.15s ease;
}

.btn-plain::after { border: none; }

/* ===== 标签 · 金边VIP ===== */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fce4ec, #f3e5f5);
  color: #7b2d4e;
  font-weight: 600;
  border: 1rpx solid rgba(212, 165, 116, 0.3);
}

.tag-vip {
  background: linear-gradient(135deg, #f4d03f, #d4a574);
  color: #4a2c00;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.4);
  border: 1rpx solid #f4d03f;
}

.tag-free {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  color: #1b5e20;
  border: 1rpx solid #a5d6a7;
}

/* ===== 选项组 ===== */
.opt-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.opt-item {
  padding: 18rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #6b4458;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  font-weight: 500;
  transition: all 0.2s ease;
}

.opt-item.active {
  background: linear-gradient(135deg, #fce4ec, #f3e5f5);
  color: #7b2d4e;
  border-color: #d4a574;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.3);
}

/* ===== 表单 ===== */
.form-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #3c2a3e;
  display: block;
  margin: 28rpx 0 12rpx;
  position: relative;
  padding-left: 20rpx;
}

.form-label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #8e44ad, #d4a574);
  border-radius: 4rpx;
}

.form-tip {
  font-size: 22rpx;
  color: #9b7a8a;
  margin-top: 8rpx;
  line-height: 1.5;
}

.form-input,
.form-textarea {
  background: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
  width: auto;
  color: #3c2a3e;
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.form-input:focus,
.form-textarea:focus {
  background: #fff;
  border-color: #d4a574;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.2);
}

.form-textarea {
  width: auto;
  min-height: 180rpx;
  line-height: 1.6;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  color: #d1b3c0;
  padding: 100rpx 0;
  font-size: 26rpx;
}

/* ===== 通用工具类 ===== */
.gradient-text {
  background: linear-gradient(135deg, #8e44ad, #ff6b9d);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* 星星装饰 */
.star-deco {
  display: inline-block;
  color: #f4d03f;
  text-shadow: 0 0 8rpx rgba(244, 208, 63, 0.5);
}
