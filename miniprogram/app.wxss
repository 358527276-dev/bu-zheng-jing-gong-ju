/* ===== 全局样式 ===== */
page {
  background: linear-gradient(180deg, #fff0f5 0%, #fdf4ff 30%, #eff6ff 100%);
  font-size: 28rpx;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* ===== 卡片 ===== */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 157, 0.06),
              0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  position: relative;
  overflow: hidden;
}

/* ===== 按钮 ===== */
.btn-primary {
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 12rpx 0;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(192, 132, 252, 0.35);
  letter-spacing: 2rpx;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: #e5e7eb;
  color: #9ca3af;
  box-shadow: none;
  opacity: 0.7;
}

.btn-plain {
  background: #fff;
  color: #ff6b9d;
  border: 2rpx solid #ff6b9d;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.15s ease;
}

.btn-plain::after {
  border: none;
}

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffe3ec, #f3e8ff);
  color: #9333ea;
  font-weight: 600;
}

.tag-vip {
  background: linear-gradient(135deg, #f7d774, #f0a830);
  color: #7a4a00;
  box-shadow: 0 4rpx 12rpx rgba(240, 168, 48, 0.3);
}

/* ===== 选项组 ===== */
.opt-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.opt-item {
  padding: 18rpx 32rpx;
  border-radius: 999rpx;
  background: #f7f8fa;
  color: #6b7280;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  font-weight: 500;
  transition: all 0.2s ease;
}

.opt-item.active {
  background: linear-gradient(135deg, #fce7f3, #f3e8ff);
  color: #9333ea;
  border-color: #c084fc;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(192, 132, 252, 0.2);
}

/* ===== 表单 ===== */
.form-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  display: block;
  margin: 28rpx 0 12rpx;
  position: relative;
  padding-left: 16rpx;
}

.form-label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #ff6b9d, #c084fc);
  border-radius: 4rpx;
}

.form-tip {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  line-height: 1.5;
}

.form-input,
.form-textarea {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
  width: auto;
  color: #1f2937;
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.form-input:focus,
.form-textarea:focus {
  background: #fff;
  border-color: #c084fc;
}

.form-textarea {
  width: auto;
  min-height: 180rpx;
  line-height: 1.6;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  color: #d1d5db;
  padding: 100rpx 0;
  font-size: 26rpx;
}

/* ===== 通用工具类 ===== */
.gradient-text {
  background: linear-gradient(135deg, #ff6b9d, #c084fc);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
