.page-header {
  padding: 12rpx 8rpx 28rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #ff6b9d, #c084fc);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.page-sub {
  font-size: 26rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.record-card {
  border-radius: 20rpx !important;
  padding: 28rpx !important;
  margin-bottom: 20rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04) !important;
}

.record-head {
  display: flex;
  align-items: center;
}

.record-icon {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #fce7f3, #fbcfe8);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.record-time {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.record-status {
  font-size: 24rpx;
  color: #f59e0b;
  font-weight: 600;
  padding: 6rpx 16rpx;
  background: #fef3c7;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.record-status.ok {
  color: #059669;
  background: #d1fae5;
}

.record-foot {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.record-type {
  font-size: 22rpx;
  color: #6b7280;
  background: #f3f4f6;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.empty-wrap {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #9ca3af;
  margin-top: 20rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #d1d5db;
  margin-top: 8rpx;
}
