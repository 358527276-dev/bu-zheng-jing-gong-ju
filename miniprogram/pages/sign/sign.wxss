.sec-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.sec-sub {
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: 400;
  margin-left: 12rpx;
}

.week-row {
  display: flex;
  justify-content: space-between;
  margin: 28rpx 0 24rpx;
}

.day-item {
  width: 80rpx;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #f9fafb;
  font-size: 20rpx;
  transition: all 0.2s ease;
}

.day-item.signed {
  background: linear-gradient(135deg, #fce7f3, #fbcfe8);
}

.day-item.today {
  border: 2rpx solid #ff6b9d;
  background: linear-gradient(135deg, #fdf2f8, #ffffff);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.2);
  transform: scale(1.05);
}

.day-num {
  font-weight: 800;
  font-size: 24rpx;
  color: #374151;
}

.day-item.signed .day-num {
  color: #db2777;
}

.day-reward {
  color: #ff6b9d;
  margin: 6rpx 0;
  font-size: 20rpx;
  font-weight: 600;
}

.day-check {
  color: #d1d5db;
  font-size: 24rpx;
}

.day-item.signed .day-check {
  color: #ec4899;
}

.next-reward {
  font-size: 24rpx;
  color: #f59e0b;
  margin-bottom: 24rpx;
  font-weight: 600;
  background: #fef3c7;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  display: inline-block;
}

button.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 800;
  border-radius: 999rpx !important;
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 100%) !important;
  box-shadow: 0 8rpx 24rpx rgba(192, 132, 252, 0.4) !important;
}

/* 任务列表 */
.task-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.task-item:last-child { border-bottom: none; }

.task-body { flex: 1; }
.task-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.task-desc {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.task-btn {
  background: linear-gradient(135deg, #ff6b9d, #c084fc);
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  box-shadow: 0 4rpx 12rpx rgba(192, 132, 252, 0.3);
}

.task-btn.done {
  background: #f3f4f6;
  color: #9ca3af;
  box-shadow: none;
}
