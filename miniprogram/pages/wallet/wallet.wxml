<view class="container">
  <!-- 免费次数卡 -->
  <view class="card bal-card">
    <view class="bal-num" wx:if="{{dailyFreeUnlimited}}">∞</view>
    <view class="bal-num" wx:else>{{dailyFreeLeft}}</view>
    <view class="bal-label">{{dailyFreeUnlimited ? '今日无限畅玩' : '今日剩余免费次数'}}</view>
    <view class="bal-vip" wx:if="{{!dailyFreeUnlimited}}">每日 {{dailyFreeTotal}} 次 · 过期自动重置</view>
  </view>

  <!-- 次数明细 -->
  <view class="card sec-card">
    <view class="sec-title">🎯 我的次数</view>
    <view class="row">
      <text>今日剩余免费</text>
      <text class="row-val">{{dailyFreeUnlimited ? '无限' : dailyFreeLeft + ' 次'}}</text>
    </view>
    <view class="row">
      <text>签到/活动赠送</text>
      <text class="row-val">{{giftFree}} 次（永久有效）</text>
    </view>
    <view class="row">
      <text>今日签到</text>
      <text class="row-val {{todaySigned ? 'c-green' : 'c-gray'}}">{{todaySigned ? '已签到 第' + signDays + '天' : '未签到'}}</text>
    </view>
  </view>

  <!-- 看广告得次数 -->
  <view class="card ad-card">
    <view class="ad-head">
      <view>
        <view class="ad-title">🎬 看广告得次数</view>
        <view class="ad-desc">看一段视频广告，立得 1 次免费使用</view>
      </view>
      <button
        class="btn-primary ad-btn"
        disabled="{{watching}}"
        bindtap="handleWatchAd"
      >{{watching ? '加载中...' : '看广告 +1'}}</button>
    </view>
    <view class="ad-progress" wx:if="{{adTask && adTask.maxProgress}}">
      今日已看 {{adTask.progress}}/{{adTask.maxProgress}} 次
    </view>
  </view>

  <!-- 赚次数入口 -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="goSign">📅 <text>签到 · 任务中心</text> <text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goInvite">🎁 <text>邀请好友得次数</text> <text class="arrow">›</text></view>
  </view>

  <!-- 客服 -->
  <view class="card menu-card">
    <button class="menu-item menu-contact" open-type="contact">💬 <text>联系客服</text> <text class="arrow">›</text></button>
  </view>

  <view class="notice">💡 全部工具免费玩！次数用完了可以看广告、签到或邀请好友继续白嫖~</view>
  <view style="height:40rpx;"></view>
</view>
