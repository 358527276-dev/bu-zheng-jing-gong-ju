.bal-card {
  text-align: center;
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 50%, #60a5fa 100%) !important;
  color: #fff;
  border-radius: 24rpx !important;
  padding: 48rpx 32rpx !important;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(192, 132, 252, 0.4) !important;
}

.bal-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

.bal-num {
  font-size: 96rpx;
  font-weight: 900;
  position: relative;
  z-index: 1;
  line-height: 1;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.bal-label {
  font-size: 28rpx;
  opacity: 0.95;
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
  font-weight: 500;
}

.bal-vip {
  margin-top: 16rpx;
  font-size: 24rpx;
  background: rgba(255,255,255,0.22);
  backdrop-filter: blur(10rpx);
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
  position: relative;
  z-index: 1;
}

.sec-card {
  margin-bottom: 24rpx;
  border-radius: 20rpx !important;
  padding: 28rpx !important;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  color: #1f2937;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #4b5563;
  border-top: 1rpx solid #f3f4f6;
}

.row:first-of-type { border-top: none; }
.row-val { font-weight: 700; color: #1f2937; }
.c-green { color: #10b981; }
.c-gray { color: #9ca3af; }

.ad-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #fef3c7, #fef9e7) !important;
  border: 2rpx solid #fde68a;
  border-radius: 20rpx !important;
  padding: 28rpx !important;
  position: relative;
  overflow: hidden;
}

.ad-card::before {
  content: '🎬';
  position: absolute;
  right: -10rpx;
  bottom: -20rpx;
  font-size: 120rpx;
  opacity: 0.15;
}

.ad-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
}

.ad-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #92400e;
}

.ad-desc {
  font-size: 24rpx;
  color: #b45309;
  margin-top: 8rpx;
}

.ad-btn {
  background: linear-gradient(135deg, #f59e0b, #ef4444) !important;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  margin: 0;
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  border-radius: 999rpx !important;
  box-shadow: 0 6rpx 16rpx rgba(239, 68, 68, 0.35) !important;
}

.ad-progress {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #92400e;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.menu-card {
  margin-bottom: 24rpx;
  border-radius: 20rpx !important;
  padding: 8rpx 28rpx !important;
}

.menu-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #1f2937;
  padding: 24rpx 0;
  border-top: 1rpx solid #f3f4f6;
  background: transparent;
  line-height: 1.4;
  font-weight: 500;
}

.menu-item:first-child { border-top: none; }
.menu-item text { flex: 1; }
.menu-item .arrow { flex: none; color: #d1d5db; font-size: 36rpx; margin-left: 12rpx; }

.menu-contact { text-align: left; border-radius: 0; }
.menu-contact::after { border: none; }

.notice {
  font-size: 24rpx;
  color: #b45309;
  background: linear-gradient(135deg, #fef3c7, #fef9e7);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 8rpx;
  line-height: 1.6;
  text-align: center;
}
