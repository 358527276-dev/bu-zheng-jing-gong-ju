/* ===== 头部背景 ===== */
.profile-header {
  margin: -24rpx -24rpx 32rpx;
  position: relative;
  padding-bottom: 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 50%, #60a5fa 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.header-bg::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: 20rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: 40rpx;
  left: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

/* ===== 用户卡片 ===== */
.user-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx 0;
}

.user-avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  position: relative;
  z-index: 2;
}

.avatar-ring {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  z-index: 1;
}

.user-info {
  flex: 1;
  color: #fff;
  min-width: 0;
}

.user-name {
  font-size: 36rpx;
  font-weight: 800;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.user-level {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  gap: 12rpx;
}

.level-badge {
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.growth-text {
  font-size: 22rpx;
  opacity: 0.85;
}

.user-code {
  font-size: 22rpx;
  opacity: 0.75;
  margin-top: 8rpx;
}

/* ===== 数据卡片网格 ===== */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 2;
}

.stat-card {
  width: 338rpx;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  background: #fff;
}

.stat-card-1 {
  background: linear-gradient(135deg, #fef3c7, #fef9e7);
}
.stat-card-2 {
  background: linear-gradient(135deg, #dbeafe, #eff6ff);
}
.stat-card-3 {
  background: linear-gradient(135deg, #d1fae5, #ecfdf5);
}
.stat-card-4 {
  background: linear-gradient(135deg, #fce7f3, #fdf2f8);
}

.stat-num {
  font-size: 48rpx;
  font-weight: 900;
  color: #1f2937;
  line-height: 1;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 10rpx;
  font-weight: 500;
}

.stat-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  opacity: 0.8;
}

/* ===== 功能菜单 ===== */
.menu-card {
  padding: 8rpx 28rpx !important;
  border-radius: 20rpx !important;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 28rpx;
  background: none;
  line-height: 1.4;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.menu-icon {
  font-size: 36rpx;
}

.menu-body {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.menu-desc {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.arrow {
  color: #d1d5db;
  font-size: 36rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.menu-share {
  text-align: left;
  border-radius: 0;
  width: 100%;
}
.menu-share::after { border: none; }

/* ===== 等级说明 ===== */
.sec-title { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; color: #1f2937; }

.lv-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.lv-row:last-child { border-bottom: none; }

.lv-name { font-weight: 600; color: #374151; }
.lv-desc { color: #9ca3af; font-size: 22rpx; }
