/* ===== 结果页头部 ===== */
.result-header {
  background: linear-gradient(135deg, #ff6b9d 0%, #c084fc 50%, #60a5fa 100%);
  margin: -24rpx -24rpx 24rpx;
  padding: 60rpx 32rpx 48rpx;
  border-radius: 0 0 32rpx 32rpx;
  position: relative;
  overflow: hidden;
}

.result-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

.result-hero {
  text-align: center;
  color: #fff;
  position: relative;
  z-index: 1;
}

.result-icon {
  font-size: 72rpx;
  animation: bounce 1s ease infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.result-title {
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 12rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.result-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* ===== 结果卡片 ===== */
.result-card {
  border-radius: 24rpx !important;
  padding: 32rpx 28rpx !important;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.1),
              0 2rpx 8rpx rgba(0, 0, 0, 0.04) !important;
}

.result-card-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  color: #1f2937;
}

.blk-text {
  font-size: 30rpx;
  line-height: 1.8;
  text-align: left;
  white-space: pre-wrap;
  color: #374151;
}

.blk-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #9ca3af;
  background: #f9fafb;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}

.blk-meme {
  font-size: 56rpx;
  font-weight: 900;
  padding: 48rpx 24rpx;
  background: linear-gradient(135deg, #fef3c7, #fce7f3);
  border-radius: 20rpx;
  text-align: center;
  line-height: 1.3;
}

.blk-list { text-align: left; margin-top: 8rpx; }
.list-item {
  display: flex;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}
.list-item:last-child { margin-bottom: 0; }

.list-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b9d, #c084fc);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 4rpx;
  font-weight: 700;
}

.list-title { font-size: 30rpx; font-weight: 600; color: #1f2937; }
.list-sub { font-size: 24rpx; color: #6b7280; margin-top: 6rpx; line-height: 1.5; }

.blk-kv { text-align: left; }
.kv-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #e5e7eb;
  font-size: 28rpx;
}
.kv-row:last-child { border-bottom: none; }
.kv-key { color: #6b7280; }
.kv-val { color: #1f2937; font-weight: 600; }

.blk-poem {
  background: linear-gradient(135deg, #fef3c7, #fef9e7);
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
}
.poem-title { font-size: 32rpx; font-weight: 700; margin-bottom: 16rpx; color: #92400e; }
.poem-line { font-size: 30rpx; line-height: 2.2; color: #78350f; }
.poem-sub { font-size: 24rpx; color: #b45309; margin-top: 16rpx; }

.blk-score { padding: 24rpx 0; text-align: center; }
.score-num {
  font-size: 100rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #ff6b9d, #c084fc);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  line-height: 1;
}
.score-label { font-size: 26rpx; color: #9ca3af; margin-top: 8rpx; }
.score-motto { margin-top: 16rpx; font-size: 28rpx; color: #6b7280; font-style: italic; }

.blk-image image {
  width: 100%;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.image-hint { font-size: 22rpx; color: #9ca3af; margin-top: 12rpx; text-align: center; }

/* ===== 操作区 ===== */
.action-section {
  margin-top: 8rpx;
}

.btn-main-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn-main-row button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 999rpx !important;
}

.btn-copy {
  background: linear-gradient(135deg, #10b981, #06b6d4) !important;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.35) !important;
}

.btn-share {
  background: linear-gradient(135deg, #ff6b9d, #c084fc) !important;
  box-shadow: 0 8rpx 24rpx rgba(192, 132, 252, 0.4) !important;
}

.btn-second-row {
  display: flex;
  gap: 16rpx;
}

.btn-second-row button {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  border-radius: 999rpx !important;
}
