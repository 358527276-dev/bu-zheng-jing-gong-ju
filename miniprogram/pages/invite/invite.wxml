<view class="container" wx:if="{{inviteInfo}}">
  <view class="card invite-hero">
    <view class="invite-title">🎁 邀好友，双方都得奖励</view>
    <view class="invite-desc">每邀请1位好友注册：你得 15次免费，好友得 10次免费</view>
    <view class="invite-code-row">
      <view class="invite-code">{{inviteInfo.inviteCode}}</view>
      <button class="btn-plain" size="mini" bindtap="onCopyCode">复制</button>
    </view>
    <button class="btn-primary" open-type="share">📤 立即邀请好友</button>
  </view>

  <view class="card">
    <view class="sec-title">已邀请 {{inviteInfo.inviteCount}} 人</view>
    <view wx:for="{{inviteList}}" wx:key="id" class="inv-item">
      <text class="inv-avatar">{{item.avatar}}</text>
      <view class="inv-body">
        <view class="inv-name">{{item.nickname}}</view>
        <view class="inv-time">{{item.createdAt}}</view>
      </view>
    </view>
    <view wx:if="{{!inviteList.length}}" class="empty">还没有好友通过你的邀请加入，快去分享吧~</view>
  </view>
</view>
